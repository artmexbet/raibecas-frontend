  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-router": "^1.147.0",
    "antd": "^6.1.4",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
