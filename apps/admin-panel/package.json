{
  "name": "raibecas-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --watch src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "docs:serve": "bun x http-server docs -p 8081 -o",
    "docs:validate": "bun x @apidevtools/swagger-cli validate docs/api-swagger.yaml"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/x-markdown": "^2.2.2",
    "@ant-design/x-sdk": "^2.2.2",
    "@editorjs/checklist": "^1.6.0",
    "@editorjs/code": "^2.9.3",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/inline-code": "^1.5.1",
    "@editorjs/list": "^2.0.2",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.4",
    "@editorjs/underline": "^1.1.0",
    "@react-buddy/ide-toolbox": "^2.4.0",
    "@tanstack/react-router": "^1.147.0",
    "antd": "^6.1.4",
    "axios": "1.13.5",
    "dayjs": "^1.11.19",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
